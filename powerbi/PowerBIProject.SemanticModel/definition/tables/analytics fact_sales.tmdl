table 'analytics fact_sales'
	lineageTag: 1371b01d-38b2-48aa-862c-0a4d2e77a5d4

	measure 'Total Orders' = DISTINCTCOUNT('analytics fact_sales'[order_id])
		lineageTag: 3c24ae4f-a271-412e-8081-66d472d2db63

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AOV = DIVIDE([Total Revenue], [Total Orders])
		formatString: #,##0.00
		lineageTag: 94af5fc7-6e33-4a90-b4d7-e3f7ff42d1e6

	measure 'Total Revenue' = SUM('analytics fact_sales'[revenue])
		lineageTag: 20e9543e-cd5f-4e0c-a31d-96122cbcf3a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Profit' = SUM('analytics fact_sales'[profit])
		lineageTag: c0562ae3-5275-4032-b6a0-fc7cfddc6fdf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Margin' = DIVIDE([Total Profit], [Total Revenue])
		lineageTag: c7ac162a-de95-465a-ab9b-efc6e95856c0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Customers' =
			
			DISTINCTCOUNT('analytics dim_customer'[customer_key])
		formatString: 0
		lineageTag: 543f81dc-305d-4f75-bfdf-81b79eeab887

	measure 'Cancellation Rate' =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('analytics fact_sales'[order_id]),
			        'analytics fact_sales'[order_status] = "Cancelled"
			    ),
			    [Total Orders]
			)
		lineageTag: fa5db30d-cf5e-4161-8ac4-f273ffa697fe

	measure 'Payment Failure Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('analytics fact_payments'),
			        'analytics fact_payments'[payment_status] = "Failed"
			    ),
			    COUNTROWS('analytics fact_payments')
			)
		lineageTag: 96663bb7-b5ce-4661-a445-840054e21c47

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'On-Time Delivery Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('analytics fact_delivery'),
			        'analytics fact_delivery'[delivery_status] = "On Time"
			    ),
			    COUNTROWS('analytics fact_delivery')
			)
		lineageTag: 1c432cf7-e9c7-43f1-a240-0fad87b2a016

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue YoY %' =
			
			VAR CurrentRevenue = [Total Revenue]
			VAR PreviousRevenue =
			    CALCULATE(
			        [Total Revenue],
			        DATEADD('analytics dim_date'[date], -1, YEAR)
			    )
			RETURN
			    DIVIDE(CurrentRevenue - PreviousRevenue, PreviousRevenue)
		formatString: 0.0%;-0.0%;-
		lineageTag: 6ecc35d0-7833-4928-97e7-b5f39221d039

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Orders YoY %' =
			
			VAR CurrentOrders = [Total Orders]
			VAR PreviousOrders =
			    CALCULATE(
			        [Total Orders],
			        DATEADD('analytics dim_date'[date], -1, YEAR)
			    )
			RETURN
			    DIVIDE(CurrentOrders - PreviousOrders, PreviousOrders)
		formatString: 0.0%;-0.0%;-
		lineageTag: 5bb04dc7-325a-4ba8-83c2-22bbb915b3ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit YoY %' =
			
			VAR CurrentProfit = [Total Profit]
			VAR PreviousProfit =
			    CALCULATE(
			        [Total Profit],
			        DATEADD('analytics dim_date'[date], -1, YEAR)
			    )
			RETURN
			    DIVIDE(CurrentProfit - PreviousProfit, PreviousProfit)
		formatString: 0.0%;-0.0%;-
		lineageTag: 24f83557-c24c-4c3b-9015-1d84d0305ff9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customers YoY %' =
			
			VAR CurrentCustomers = [Total Customers]
			VAR PreviousCustomers =
				CALCULATE(
					[Total Customers],
					DATEADD('analytics dim_date'[date], -1, YEAR)
				)
			RETURN
				DIVIDE(CurrentCustomers - PreviousCustomers, PreviousCustomers)
		formatString: 0.0%;-0.0%;-
		lineageTag: 8d7f5f0e-0a3b-4e2f-9d9a-4f1d5f5d8c12

