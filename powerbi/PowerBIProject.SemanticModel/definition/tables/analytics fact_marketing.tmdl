table 'analytics fact_marketing'
	lineageTag: 609a0bed-fdb1-4f58-99d8-65f908a1a58f

	measure 'Total Marketing Spend' =
			
			SUM('analytics fact_marketing'[spend])
		lineageTag: 27d56bf5-9b79-49e5-87a2-257947d73b8b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Conversion Rate' =
			
			DIVIDE(
			    SUM('analytics fact_marketing'[conversions]),
			    SUM('analytics fact_marketing'[clicks])
			)
		lineageTag: e7b3576b-7e35-4156-a18c-601b5d223693

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column marketing_key
