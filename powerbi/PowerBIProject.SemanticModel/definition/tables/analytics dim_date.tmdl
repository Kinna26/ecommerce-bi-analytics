table 'analytics dim_date'
	lineageTag: 486aafc3-5f68-4e79-982b-53c8f85a411b

	measure 'AOV YoY %' =
			
			VAR CurrentAOV = [AOV]
			VAR PreviousAOV =
			    CALCULATE(
			        [AOV],
			        DATEADD('analytics dim_date'[date], -1, YEAR)
			    )
			RETURN
			    DIVIDE(CurrentAOV - PreviousAOV, PreviousAOV)
		formatString: 0.0%;-0.0%;-
		lineageTag: 99e7b2ba-8768-464f-9320-9d0abdbe5613

		annotation PBI_FormatHint = {"isGeneralNumber":true}

